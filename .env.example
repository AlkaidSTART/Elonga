# ================================
# Elonga Docker Compose 环境变量配置
# 首次运行 ./start.sh 时会自动从此文件生成 .env
# ================================

# 应用端口
APP_PORT=3000

# MySQL 数据库配置
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=elonga_root_2026
MYSQL_DATABASE=elonga
MYSQL_USER=elonga
MYSQL_PASSWORD=elonga_pass_2026

# 鉴权与会话配置
# 生产环境建议替换为至少 32 位随机字符串（start.sh 首次生成 .env 时会自动随机化）
JWT_SECRET=elonga-docker-jwt-secret-please-change-2026
# 本地 HTTP 访问保持 false；若前置了 HTTPS 反向代理，建议改为 true
AUTH_COOKIE_SECURE=false
AUTH_ADMIN_PASSWORD=elonga2026
AUTH_EDITOR_PASSWORD=editor2026

# ================================
# 可选：AI 模型与外部服务 API 配置
# ================================
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
TEXT_API_KEY=
TEXT_BASE_URL=
OPENAI_API_KEY=

IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=
ARK_API_KEY=
ARK_BASE_URL=

VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=

DOUYIN_TRENDS_API_URL=
DOUYIN_TRENDS_API_KEY=
